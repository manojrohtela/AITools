# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Repository DevPilot analyzes (default: current working directory)
DEVPILOT_REPO_PATH=

# Groq model with tool-use support (default: openai/gpt-oss-120b)
# Alternative production model that also supports parallel tool calls: llama-3.3-70b-versatile
DEVPILOT_MODEL=openai/gpt-oss-120b

# Loop and execution limits
DEVPILOT_MAX_TOOL_ROUNDS=10
DEVPILOT_MAX_TOOL_CALLS=30
DEVPILOT_TOOL_TIMEOUT=60
DEVPILOT_TEST_TIMEOUT=120
DEVPILOT_API_TIMEOUT=60

# Ask Groq for parallel tool calls (only for models that support it). Default: false
DEVPILOT_PARALLEL_TOOL_CALLS=false

# Permissions
DEVPILOT_ALLOW_TEST_EXECUTION=true
DEVPILOT_ALLOW_REPORTS=true

# Python interpreter used to run the target repo's pytest (default: DevPilot's interpreter)
DEVPILOT_PYTHON=

# Where reports are written (default: ./reports inside DevPilot)
DEVPILOT_REPORTS_DIR=

# Comma-separated additions to the built-in lists
DEVPILOT_EXTRA_EXCLUDED_DIRS=
DEVPILOT_EXTRA_SENSITIVE_PATTERNS=
